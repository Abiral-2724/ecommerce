// new model 
enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  CREATED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String   @id @default(uuid())
  userId          String
  totalAmount     Int
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus
  orderStatus     OrderStatus
  razorpayOrderId String?
  deliveryDate DateTime?
  addressId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

user User @relation(fields: [userId] ,references: [id])
address Address? @relation(fields: [addressId], references: [id])
  payment Payment?
  items   OrderItem[]
  refunds Refund[]
  returns Return[]
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  price        Int
  isReturnable Boolean
  returnStatus ReturnStatus?

  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}



model Payment {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  razorpayOrderId    String? @unique
  razorpayPaymentId  String?
  razorpaySignature  String?
  amount             Int
  currency           String
  status             PaymentStatus
  createdAt          DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Refund {
  id               String   @id @default(uuid())
  orderId          String
  paymentId        String
  razorpayRefundId String?
  amount           Int
  reason           String
  status           RefundStatus
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
  REFUNDED
}

model Return {
   id  String   @id @default(uuid())
   productId String 
   orderId String
   userId String
   reason String
  amount Int
  status ReturnStatus
  createdAt        DateTime @default(now())
approvedAt  DateTime?
  rejectedAt  DateTime?
  pickedAt    DateTime?
  refundedAt  DateTime?
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id String @id @default(uuid())
  storeName String
  storeAddress String
  storePincode String
  storeCity String
  storeState States
  storeImage String?
  storePhoneNumber String
  storeOpenDayStart WeekDays
  storeOpenDayEnd WeekDays
  storeOpeningTimeing String?  // Made nullable for 24/7 stores
  storeClosingTiming  String?  // Made nullable for 24/7 stores
  is24x7              Boolean  @default(false)  // Flag for 24-hour stores
  storeLocationUrl String
  createdAt           DateTime @default(now())
}

model Corporate{
    id  String   @id @default(uuid())
    name String
    companyName String
    contact String
    companyEmail String
    askAnying String?
    quantity Int
    status Status @default(PENDING)
    createdAt        DateTime @default(now())
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

