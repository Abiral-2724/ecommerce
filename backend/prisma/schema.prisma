enum PaymentType {
  CASEONDELIVERY 
  PHONEPAY
  UPI
  DEBITCARD
  CREDITCARD
  PAYTM
  NETBANKING
}

model User {
  id          String   @id @default(uuid())
  name        String?
  email       String?  @unique
  phoneNumber String   @unique
  role        Role     @default(USER)
  createdAt   DateTime @default(now())

  // Relations
  address   Address[]
  wishlists Wishlist[]
  reviews   Review[]
  carts     CartItems[]
  review customerReview[]
  orders Order[]
  returns Return[]
  warrantyClaims WarrantyClaim[]
}

model Address {
  id            String  @id @default(uuid())
  ownerId       String
  user          User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fullname      String
  email         String
  pincode       String
  mobile        String
  city          String
  state         String
  country       String  @default("India")
  streetAddress String
  locality      String
  landmark      String?
  GSTIN         String?

  orders Order[]
}

model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  imageUrl String?
  parentId String?

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  // products    Product[]

  createdAt DateTime   @default(now())
}

model Product {
  id                         String   @id @default(uuid())
  name                       String
  originalPrice              Int
  discountPrice              Int
  type                       String?
  tags                       String[] @default([])
  description                String
  shortDescription           String?
  material                   String
  highlights        String?
  keyFeatures       String?
  dimensions                 String
  weight                     Decimal
  packageContent             String
  care                       String
  countryOfOrigin            String
  manufacturerName           String
  packerName                 String
  importerName               String
  delivery                   String
  caseOnDeliveryAvailability Boolean
  returnDetails              String
  createdAt                  DateTime @default(now())
  primaryImage1              String
  primaryImage2              String
  categoryId                 String
  totalCount Int @default(0)
  // category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  wishlists Wishlist[]
  reviews   Review[]
  images    ProductImages[]
  cart      CartItems[]
  colors    ProductColor[]
  review    customerReview[]
   orderItems OrderItem[]
   returns Return[]
}

model ProductColor {
  id          String  @id @default(uuid())
  name        String
  hex         String?
  productId   String
  colorImage1 String
  colorImage2 String
  colorImage3 String?
  colorImage4 String?
  colorImage5 String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImages {
  id          String  @id @default(uuid())
  url         String
  altText     String?
  description String?
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  
  rating    Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
 
}

model CartItems {
  id                       String   @id @default(uuid())
  ownerId                  String
  productId                String
  quantity                 Int      @default(1)
  couponCode               String?
  couponDiscountPercentage Int      @default(0)
  addAsGift                Boolean  @default(false)
  chargeForGift            Int      @default(0)
  giftRecipentname         String   @default("None")
  giftSendername           String   @default("None")
  giftMessageFromSender    String   @default("None")
  createdAt                DateTime @default(now())

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CouponsCode {
  id                 String    @id @default(uuid())
  code               String    @unique
  discountPercentage Int
  minOrderAmount     Int
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
}

model Pincode {
  id      String @id @default(uuid())
  pincode Int
}

model customerReview {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId] ,references: [id] ,onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId] ,references: [id] ,onDelete: Cascade)
  title String?
  description String
  rating Int
  createdAt   DateTime @default(now())
}

